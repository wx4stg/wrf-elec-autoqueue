#!/bin/bash
#SBATCH --job-name=ideal
#SBATCH --output=ideal.out
#SBATCH --error=ideal.err
#SBATCH --partition=nocona
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --time=02:00:00
#SBATCH --mail-type=ALL
# --mail-user is passed on the sbatch command line by wrf-compile.sh

source /lustre/work/$USER/spack/share/spack/setup-env.sh
spack load gcc glibc openmpi parallel-netcdf wps netcdf-fortran wrf automake hdf5 bzip2 netcdf-c jasper libpng zlib-ng zlib
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$(spack location -i netcdf-fortran)/lib/
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$(spack location -i netcdf-c)/lib/
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$(spack location -i zlib)/lib/
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$(spack location -i jasper)/lib64/
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$(spack location -i libpng)/lib/

cd /lustre/work/$USER/wrf4-elec/test/em_quarter_ss

rm -f wrfinput_d01
mpirun -np 16 /lustre/work/$USER/wrf4-elec/test/em_quarter_ss/ideal.exe

if [ ! -f wrfinput_d01 ]; then
    echo "ideal.exe did not produce wrfinput_d01" >&2
    exit 1
fi
