#!/bin/bash
#SBATCH --job-name=spackins
#SBATCH --output=spack_ins.out
#SBATCH --error=spack_ins.err
#SBATCH --partition=nocona
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=2
#SBATCH --time=06:00:00
#SBATCH --mail-type=ALL
# --mail-user is passed on the sbatch command line by wrf-compile.sh

cd /lustre/work/$USER/spack
. share/spack/setup-env.sh
spack install gcc glibc openmpi parallel-netcdf wps netcdf-fortran wrf automake hdf5 bzip2 netcdf-c jasper libpng zlib-ng zlib || exit 1

# WPS expects netcdf-fortran and netcdf-c to be installed in the same location,
# so copy the netcdf-c libraries into the netcdf-fortran directory.
cp -ar $(spack location -i netcdf-c)/lib/. $(spack location -i netcdf-fortran)/lib/ || exit 1
